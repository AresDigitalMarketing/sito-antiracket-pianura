{%- set menu = [
  ["/", "Home"],
  ["/notizie/", "Notizie"],
  ["/la-nostra-storia/", "La nostra storia"],
  ["/convenzione-antiracket/", "Convenzione"],
  ["/comunicati-stampa/", "Comunicati"],
  ["/documenti/", "Documenti"],
  ["/por-campania/", "P.O.R. Campania"],
  ["/legge-124-2017/", "Legge 124/2017"],
  ["/fotogallery/", "Fotogallery"],
  ["/videogallery/", "Videogallery"]
] -%}
{%- set titoloPagina = (title + " – " + site.nome) if title else (site.nome + " – Associazione antiracket di Pianura") -%}
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titoloPagina }}</title>
<meta name="description" content="{{ (excerpt or sottotitolo or site.descrizione) | striptags | truncate(160) }}">
{%- if site.modalita_prova %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}
<meta property="og:title" content="{{ title or site.nome }}">
<meta property="og:description" content="{{ (excerpt or sottotitolo or site.descrizione) | striptags | truncate(200) }}">
<meta property="og:type" content="{{ 'article' if layout == 'layouts/articolo.njk' else 'website' }}">
{%- if image %}<meta property="og:image" content="{{ image }}">{% endif %}
<link rel="icon" href="/assets/img/logo-pianura.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/public-sans.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/style.css?v={{ versione }}">
{%- if site.url %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- endif %}
<!-- Google Consent Mode v2 (tutto negato finché non c'è consenso) + Google Tag Manager -->
<script>
window.SITO_TRACCIAMENTO={gtm:"{{ site.gtm_id }}",pixel:"{{ site.meta_pixel_id }}"};
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',functionality_storage:'granted',security_storage:'granted',wait_for_update:500});
gtag('set','ads_data_redaction',true);gtag('set','url_passthrough',true);
try{var c=JSON.parse(localStorage.getItem('apl_consent_v1'));if(c&&Date.now()-c.t<15552e6)gtag('consent','update',{analytics_storage:c.s?'granted':'denied',ad_storage:c.m?'granted':'denied',ad_user_data:c.m?'granted':'denied',ad_personalization:c.m?'granted':'denied'})}catch(e){}
{%- if site.gtm_id %}
(function(w,d,s,l,i){w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f)})(window,document,'script','dataLayer','{{ site.gtm_id }}');
{%- endif %}
</script>
<script src="/assets/js/consenso.js?v={{ versione }}" defer></script>
</head>
<body>
<a class="salta" href="#contenuto">Vai al contenuto</a>
{%- if site.modalita_prova %}
<div class="avviso-prova">Versione di prova del nuovo sito</div>
{%- endif %}

<header class="testata">
  <div class="contenitore">
    <a class="marchio" href="/">
      <img src="/assets/img/logo-pianura.svg" alt="Logo Associazione Antiracket Pianura per la Legalità, in memoria di Gigi e Paolo" width="182" height="236">
      <span class="marchio-testo">
        <span class="marchio-nome">{{ site.nome }}</span>
        <span class="marchio-sotto">Associazione antiracket · Aps</span>
      </span>
    </a>
    <nav class="menu" aria-label="Menu principale">
      {%- for voce in menu %}
      <a href="{{ voce[0] }}"{% if page.url == voce[0] or (voce[0] != '/' and page.url.startsWith(voce[0])) %} aria-current="page"{% endif %}>{{ voce[1] }}</a>
      {%- endfor %}
      <a class="pulsante" href="/contatti/">Contatti</a>
    </nav>
    <details class="menu-mobile">
      <summary>☰ Menu</summary>
      <nav aria-label="Menu principale (mobile)">
        {%- for voce in menu %}
        <a href="{{ voce[0] }}">{{ voce[1] }}</a>
        {%- endfor %}
        <a href="/contatti/">Contatti</a>
      </nav>
    </details>
  </div>
</header>

<main id="contenuto">
{{ content | safe }}
</main>

<section class="rete" aria-label="Rete per la Legalità">
  <div class="contenitore">
    <img src="/assets/img/logo-rete.svg" alt="Logo Rete per la Legalità – Associazioni e Fondazioni contro il racket e l’usura" width="354" height="232" loading="lazy">
    <p>Aderente alla <strong>Rete per la Legalità</strong>, la rete nazionale di associazioni e fondazioni contro il racket e l’usura.</p>
  </div>
</section>

<footer class="piede">
  <div class="contenitore piede-alto">
    <img class="piede-logo" src="/assets/img/logo-pianura.svg" alt="" width="182" height="236" loading="lazy">
    <p class="piede-testo"><strong>{{ site.nome_completo }}.</strong> {{ site.iscrizioni }}</p>
  </div>
  <div class="piede-fondo">
    <div class="contenitore">
      <span>© {{ anno }} Antiracket Pianura</span>
      <nav class="piede-link" aria-label="Note legali">
        <a href="/privacy-policy/">Privacy policy</a>
        <a href="/cookie-policy/">Cookie policy</a>
        <a href="#" data-cookie-prefs>Preferenze cookie</a>
        <a href="/admin/">Area riservata</a>
      </nav>
    </div>
  </div>
</footer>
<script src="/assets/js/sito.js?v={{ versione }}" defer></script>
</body>
</html>
