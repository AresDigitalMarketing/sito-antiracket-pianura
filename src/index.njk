---
layout: layouts/base.njk
---
{%- import "schede.njk" as s -%}
<section class="apertura">
  <div class="contenitore">
    <div class="apertura-testo">
      <p class="occhiello">{{ home.occhiello }}</p>
      <h1 style="white-space: pre-line">{{ home.titolo }}</h1>
      <p class="intro">{{ home.testo }}</p>
      <div class="pulsanti">
        <a class="pulsante giallo" href="/contatti/">Contattaci</a>
        <a class="pulsante contorno-chiaro" href="/convenzione-antiracket/">Aderisci alla Convenzione</a>
      </div>
    </div>
  </div>
</section>

{%- if collections.notizie.length %}
<section class="sezione" style="padding-top:24px" aria-labelledby="notizie">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="notizie">Notizie</h2>
      <a href="/notizie/">Tutte le notizie →</a>
    </div>
    <div class="griglia">
      {%- for n in collections.notizie | primi(3) %}{{ s.notizia(n) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="adesioni" aria-label="Convenzione e Patto Antiracket">
  <a class="adesione blu" href="/convenzione-antiracket/">
    <small>Per i commercianti</small>
    <strong>Convenzione Antiracket</strong>
    <span>Un’iniziativa gratuita rivolta agli operatori economici per prevenire racket e usura e aiutare chi riceve richieste estorsive, insieme all’associazione e alle Forze dell’Ordine.</span>
    <em>Scopri come aderire →</em>
  </a>
  <a class="adesione verde" href="/il-patto-antiracket/">
    <small>Per le imprese edili</small>
    <strong>Patto Antiracket</strong>
    <span>Adesione volontaria e gratuita: l’impresa si impegna a respingere ogni richiesta illecita e a denunciare, l’associazione la accompagna e la sostiene.</span>
    <em>Scopri il Patto →</em>
  </a>
</section>

{%- if collections.comunicati.length %}
<section class="sezione" aria-labelledby="comunicati">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="comunicati">Ultimi comunicati stampa</h2>
      <a href="/comunicati-stampa/">Tutti i comunicati →</a>
    </div>
    <div class="griglia stretta">
      {%- for c in collections.comunicati | primi(4) %}{{ s.comunicato(c) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="sezione" aria-labelledby="storia">
  <div class="contenitore due-colonne">
    <div style="display:flex;flex-direction:column;gap:18px;flex:1 1 320px">
      <h2 id="storia">La nostra storia</h2>
      <p style="margin:0;font-size:18px;color:var(--testo-2)">Portiamo il nome di Luigi Sequino e Paolo Castaldi, giovani di Pianura uccisi innocenti dalla camorra il 10 agosto 2000. Dalla loro memoria è nato un impegno che dura da oltre vent’anni.</p>
      <a href="/la-nostra-storia/" style="font-weight:600">Leggi la storia completa →</a>
    </div>
    <ol class="tempo" style="flex:2 1 480px">
      {%- for t in home.tappe %}
      <li><b>{{ t.data }}</b>{{ t.testo }}</li>
      {%- endfor %}
    </ol>
  </div>
</section>

{%- if collections.album.length %}
<section class="sezione bianca" aria-labelledby="foto">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="foto">Dalla fotogallery</h2>
      <a href="/fotogallery/">Tutti gli album →</a>
    </div>
    <div class="griglia">
      {%- for a in collections.album | primi(3) %}{{ s.album(a) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if site.facebook or site.instagram or site.youtube %}
<section class="sezione" aria-labelledby="seguici">
  <div class="contenitore" style="display:flex;flex-wrap:wrap;gap:16px 40px;align-items:center">
    <h2 id="seguici">Seguici sui social</h2>
    {% include "social.njk" %}
  </div>
</section>
{%- endif %}
