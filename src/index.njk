---
layout: layouts/base.njk
---
{%- import "schede.njk" as s -%}
<section class="apertura">
  <div class="contenitore">
    <div class="apertura-testo">
      <p class="occhiello">{{ home.occhiello }}</p>
      <h1 style="white-space: pre-line">{{ home.titolo }}</h1>
      <p class="intro">{{ home.testo }}</p>
      <div class="pulsanti">
        <a class="pulsante giallo" href="/contatti/">Contattaci</a>
        <a class="pulsante contorno-chiaro" href="/convenzione-antiracket/">Aderisci alla Convenzione</a>
      </div>
    </div>
  </div>
</section>

<section class="sezione" aria-labelledby="cosa">
  <div class="contenitore">
    <h2 id="cosa" style="margin-bottom:28px">Cosa facciamo</h2>
    <div class="griglia tre">
      {%- for a in home.attivita %}
      <div class="attivita">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#007A3D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {%- if loop.index == 1 %}<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>
          {%- elif loop.index == 2 %}<path d="M4 7h16v12H4z"/><path d="M9 7V5h6v2"/><path d="M4 12h16"/>
          {%- else %}<path d="M3 10l9-5 9 5-9 5z"/><path d="M7 12v4c3 2 7 2 10 0v-4"/>{% endif %}
        </svg>
        <h3>{{ a.titolo }}</h3>
        <p>{{ a.testo }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

{%- if collections.notizie.length %}
<section class="sezione" style="padding-top:24px" aria-labelledby="notizie">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="notizie">Notizie</h2>
      <a href="/notizie/">Tutte le notizie →</a>
    </div>
    <div class="griglia">
      {%- for n in collections.notizie | primi(3) %}{{ s.notizia(n) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if collections.comunicati.length %}
<section class="sezione" style="padding-top:24px" aria-labelledby="comunicati">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="comunicati">Ultimi comunicati stampa</h2>
      <a href="/comunicati-stampa/">Tutti i comunicati →</a>
    </div>
    <div class="griglia stretta">
      {%- for c in collections.comunicati | primi(4) %}{{ s.comunicato(c) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="sezione bianca" aria-labelledby="convenzione">
  <div class="contenitore due-colonne">
    <div style="display:flex;flex-direction:column;gap:18px">
      <p class="occhiello" style="color:var(--verde)">Per commercianti e imprese</p>
      <h2 id="convenzione" style="font-size:40px;color:var(--blu-scuro)">La Convenzione Antiracket</h2>
      <p style="margin:0;font-size:18px;color:var(--testo-2)">Nata dall’esperienza decennale del Patto Antiracket con le imprese edili, aiuta gli operatori economici a respingere le richieste estorsive in collaborazione con l’associazione e le Forze dell’Ordine. L’adesione è completamente gratuita, cartellone incluso.</p>
      <div class="pulsanti">
        <a class="pulsante" href="/convenzione-antiracket/">Scopri come aderire</a>
        <a class="pulsante contorno" href="/il-patto-antiracket/">Il Patto per le imprese edili</a>
      </div>
    </div>
    <ol class="passi">
      <li><b class="n">1</b><div><strong>Invia la richiesta</strong><span>Scrivi a {{ site.email }} con recapiti e PEC dell’impresa, visura camerale e documenti del titolare.</span></div></li>
      <li><b class="n">2</b><div><strong>Valutazione in 15 giorni</strong><span>Una commissione esamina la domanda e ti comunica l’esito.</span></div></li>
      <li><b class="n">3</b><div><strong>Firma e ritira il cartellone</strong><span>In una delle nostre sedi firmi la Convenzione e ricevi il cartellone da esporre nella tua attività.</span></div></li>
    </ol>
  </div>
</section>

<section class="sezione" aria-labelledby="storia">
  <div class="contenitore due-colonne">
    <div style="display:flex;flex-direction:column;gap:18px;flex:1 1 320px">
      <h2 id="storia">La nostra storia</h2>
      <p style="margin:0;font-size:18px;color:var(--testo-2)">Portiamo il nome di Luigi Sequino e Paolo Castaldi, giovani di Pianura uccisi innocenti dalla camorra il 10 agosto 2000. Dalla loro memoria è nato un impegno che dura da oltre vent’anni.</p>
      <a href="/la-nostra-storia/" style="font-weight:600">Leggi la storia completa →</a>
    </div>
    <ol class="tempo" style="flex:2 1 480px">
      {%- for t in home.tappe %}
      <li><b>{{ t.data }}</b>{{ t.testo }}</li>
      {%- endfor %}
    </ol>
  </div>
</section>

{%- if collections.album.length %}
<section class="sezione bianca" aria-labelledby="foto">
  <div class="contenitore">
    <div class="sezione-testa">
      <h2 id="foto">Dalla fotogallery</h2>
      <a href="/fotogallery/">Tutti gli album →</a>
    </div>
    <div class="griglia">
      {%- for a in collections.album | primi(3) %}{{ s.album(a) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if site.facebook or site.instagram or site.youtube %}
<section class="sezione" aria-labelledby="seguici">
  <div class="contenitore" style="display:flex;flex-wrap:wrap;gap:16px 40px;align-items:center">
    <h2 id="seguici">Seguici sui social</h2>
    {% include "social.njk" %}
  </div>
</section>
{%- endif %}
