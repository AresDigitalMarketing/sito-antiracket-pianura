// Configurazione per Cloudflare Workers: pubblica la cartella _site generata da Eleventy.
{
  "name": "antiracket-pianura",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "www.antiracketpianura.it", "custom_domain": true }
  ],
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
